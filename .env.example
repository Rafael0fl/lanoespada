# Plantilla de variables de entorno del frontend.
# Copiala como .env.development (desarrollo) o .env.production (produccion).
# Este archivo SI se sube a git (no tiene secretos).

# --- Modo demo / pseudo-DB ---------------------------------------------------
# Permite que la interfaz caiga a datos FICTICIOS cuando el backend esta apagado.
#
#   VITE_DEMO_MODE=true   -> desarrollo. Si el backend no responde, la interfaz
#                            sigue funcionando con datos de prueba.
#   VITE_DEMO_MODE=false  -> produccion. Si el backend no responde, el usuario
#                            ve un error de conexion (NUNCA datos inventados).
#
# Es "opt-in": si la variable no esta definida, el modo demo queda DESHABILITADO.
VITE_DEMO_MODE=false

# --- URL del backend (opcional) ---------------------------------------------
# Si NO la definis, el frontend usa '/v1' y depende del proxy de Vite
# (ver vite.config.js) o del servidor donde se sirvan los archivos.
#
#   Desarrollo:  '/v1' + proxy de Vite -> http://localhost:8000
#   Produccion:  'https://api.tudominio.com/v1'
# VITE_API_URL=/v1